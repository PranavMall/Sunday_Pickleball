{
  "expo": {
    "name": "Pickle-Ballers",
    "slug": "pickle-ballers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pickleballers",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pickleballers.game",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.pickleballers.game",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2150AC"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2150AC"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "pranamall15",
    "extra": {
      "eas": {
        "projectId": "663164d9-df03-4a00-af86-0cf062f1b4ac"
      }
    }
  }
}
